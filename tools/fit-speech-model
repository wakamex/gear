#!/usr/bin/env -S uv run --no-project --with lightgbm --with scikit-learn --with numpy python3
"""Fits the model that tells speech from the other sounds a voice makes, and writes src/speech_model.h.

    tools/fit-speech-model ROWS.jsonl                  fit and write the model
    tools/fit-speech-model ROWS.jsonl --trees 100      a larger one (default 40 trees of 8 leaves)
    tools/fit-speech-model ROWS.jsonl --dry            print how it scores, write nothing

ROWS.jsonl has one line per piece of sound the recognizer wrote words into:
{"y": 1 for speech or 0, "group": the speaker, "kind": what the sound is, "in": the 17 inputs of
src/speech.h in their order}. The inputs are what gear itself computes for a piece and keeps in
heard.jsonl as "inputs", so a row is such a line with its label added.

The model is gradient-boosted trees (LightGBM), written as a table that src/speech.c walks. Its score is
checked on speakers it was not fitted on (five folds), and the cut is the score below which 2% of the
speech falls. A few rows go into the header with the scores LightGBM gives them, for the tests to check
the table against.
"""

import argparse
import json
import os
import sys

import lightgbm as lgb
import numpy as np
from sklearn.model_selection import StratifiedGroupKFold

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
INPUTS = ["silero share above 0.95", "silero share above 0.99", "silero share above 0.9", "silero share above 0.8", "silero peak", "silero mean",
          "raw score", "margin over blank", "margin over runner-up", "log-sum-exp", "top probability", "confidence",
          "second detector share above 0.5", "second detector share above 0.9", "second detector share above 0.95", "second detector peak",
          "second detector mean"]


def cut_for(score, y, loss):
    """The highest cut that drops at most `loss` of the speech, and the share of the rest it lets through."""
    pos = np.sort(score[y == 1])
    best = (-np.inf, 1.0)
    for cut in np.unique(pos):
        if np.searchsorted(pos, cut, side="left") / len(pos) <= loss:
            best = (float(cut), float((score[y == 0] >= cut).mean()))
    return best


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("rows")
    parser.add_argument("--trees", type=int, default=40)
    parser.add_argument("--leaves", type=int, default=8)
    parser.add_argument("--rate", type=float, default=0.15)
    parser.add_argument("--loss", type=float, default=0.02, help="the share of speech the cut may drop (default 0.02)")
    parser.add_argument("--dry", action="store_true")
    args = parser.parse_args()

    rows = [json.loads(line) for line in open(args.rows)]
    X = np.array([r["in"] for r in rows], dtype=np.float32).astype(float)
    y = np.array([r["y"] for r in rows])
    groups = np.array([r["group"] for r in rows])
    kinds = np.array([r.get("kind", "") for r in rows])
    if X.shape[1] != len(INPUTS):
        sys.exit(f"{X.shape[1]} inputs a row; src/speech.h has {len(INPUTS)}")

    def model():
        return lgb.LGBMClassifier(n_estimators=args.trees, learning_rate=args.rate, num_leaves=args.leaves, min_child_samples=30, verbose=-1,
                                  random_state=0, n_jobs=4)

    held = np.zeros(len(y))
    for train, test in StratifiedGroupKFold(n_splits=5, shuffle=True, random_state=0).split(X, y, groups):
        held[test] = model().fit(X[train], y[train]).predict_proba(X[test])[:, 1]
    cut, through = cut_for(held, y, args.loss)
    print(f"{int((y == 1).sum())} speech and {int((y == 0).sum())} other pieces from {len(set(groups))} speakers; {args.trees} trees of {args.leaves} leaves")
    print(f"on speakers held out: at a cut of {cut:.4f}, {100 * (held[y == 1] < cut).mean():.1f}% of speech is dropped and {100 * through:.1f}% of the rest gets through")
    for loss in (0.01, 0.05):
        print(f"  dropping {100 * loss:.0f}% of speech instead: {100 * cut_for(held, y, loss)[1]:.1f}% gets through")
    for kind in sorted(set(kinds[y == 0])):
        pick = (kinds == kind) & (y == 0)
        print(f"  {kind}: {100 * (held[pick] >= cut).mean():.0f}% of {int(pick.sum())} gets through")
    for kind in sorted(set(kinds[y == 1])):
        pick = (kinds == kind) & (y == 1)
        print(f"  {kind}: {100 * (held[pick] < cut).mean():.1f}% of {int(pick.sum())} dropped")
    if args.dry:
        return

    fitted = model().fit(X, y)
    nodes, roots = [], []

    def walk(t):
        at = len(nodes)
        nodes.append(None)
        if "leaf_value" in t:
            nodes[at] = (-1, 0, 0, t["leaf_value"])
        else:
            if t["decision_type"] != "<=":
                sys.exit(f"a split of type {t['decision_type']}, which src/speech.c does not walk")
            left, right = walk(t["left_child"]), walk(t["right_child"])
            nodes[at] = (t["split_feature"], left, right, t["threshold"])
        return at

    for tree in fitted.booster_.dump_model()["tree_info"]:
        roots.append(walk(tree["tree_structure"]))
    order = np.argsort(np.abs(fitted.predict_proba(X)[:, 1] - cut))
    checks = [int(i) for i in list(np.flatnonzero(y == 1)[:3]) + list(np.flatnonzero(y == 0)[:3]) + list(order[:2])]
    expected = fitted.predict_proba(X[checks])[:, 1]

    with open(os.path.join(ROOT, "src", "speech_model.h"), "w") as f:
        f.write("// Written by tools/fit-speech-model; do not edit. The model of src/speech.c: gradient-boosted trees over the\n")
        f.write(f"// inputs of src/speech.h, fitted on {int((y == 1).sum())} pieces of speech and {int((y == 0).sum())} of other vocal sounds that the\n")
        f.write(f"// recognizer wrote words into. On speakers held out, the cut drops {100 * (held[y == 1] < cut).mean():.1f}% of the speech and lets {100 * through:.1f}% of the\n")
        f.write("// rest through.\n")
        f.write(f"static const float speech_cut = {cut:.6f}f;\n")
        f.write("// A node: the input it compares (-1 for a leaf), where to go when the input is at most `value` and where otherwise;\n")
        f.write("// a leaf's value is what its tree adds to the score.\n")
        f.write("static const struct { signed char input; unsigned short low, high; double value; } speech_nodes[] = {\n")
        for i in range(0, len(nodes), 4):
            f.write("    " + " ".join(f"{{ {n[0]}, {n[1]}, {n[2]}, {n[3]!r} }}," for n in nodes[i:i + 4]) + "\n")
        f.write("};\n")
        f.write("static const unsigned short speech_roots[] = { " + ", ".join(map(str, roots)) + " };\n")
        f.write("// Rows of the fitting data with the scores LightGBM gives them, for the tests.\n")
        f.write(f"static const struct {{ float in[{len(INPUTS)}]; float score; }} speech_checks[] = {{\n")
        for i, e in zip(checks, expected):
            f.write("    { { " + ", ".join(f"{float(v)!r}f" for v in X[i]) + f" }}, {float(e):.6f}f }},\n")
        f.write("};\n")
    print(f"wrote src/speech_model.h: {len(roots)} trees, {len(nodes)} nodes")


if __name__ == "__main__":
    main()
